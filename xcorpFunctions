//--- DataLace program's begin: 
//The purpose of data lace is to allow array manipulation with integrated size so you do not have to pass the size of the array manually, they are dynamic as well.




//Desgined to convert a static array with known sizes to a DataLace array. XYZ Represent values of the 3d array, and the ** represents the datalaced array being written

void statToDLa3dE(int x, int y, int z, int arrayinput[x][y][z], int **datalaced_array) //static to datalace array 3d- Empty array [23]
{

	int totalSize = x * y * z; //Simplifies this so it is not one giant line below
	int *flatVer = malloc((totalSize+1)*(sizeof(arrayinput[0][0][0]))); //Calculates byte size needed for DataLace, adds 1 due to meta data being encoded
	int flatLoc;

	if (flatVer == NULL)
	{
		printf("Error occured at process: [DL23-NR] / %p ", (void *)arrayinput); //Process DL23 had a null return
		return;
	}


	if ((x < 0) ||  (y < 0) ||  (z < 0))
	{
		printf("Error occured at process: [DL23-NV] \n X:  %d, Y: %d, Z: %d \n", x,y,z) ; //Process DL23 had a Negative Value
		return;
	}



	flatVer[0] = (x * 1000000) + (y * 1000) + z; //Set size of Datalaced array in grid "0,0,0" ie spot 0





	for(int xCount = 0; xCount < x; xCount++)
	{

		for(int yCount = 0; yCount < y; yCount++)
		{
			for(int zCount = 0; zCount < z; zCount++)
			{




				flatLoc = xCount * y * z + yCount * z + zCount;

				flatVer[flatLoc+1] = arrayinput[xCount][yCount][zCount];







			}
		}

	}

	*datalaced_array = flatVer;
	return;

}




