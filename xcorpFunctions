void arrayGenINT(int min, int max, int row, int column,int tempGenArray[row][column])
{
    
    srand(time(NULL));
    
    
    
    int rowCount = 0; //X counter for array gen 
    int columnCount = 0; // Y count for array gen

    
    

    
    
    while(rowCount < row)
    {
        columnCount = 0;
        
    
        while(columnCount < column)
        {
            
            
            
            tempGenArray[rowCount][columnCount] = (min + rand() % (max - min + 1));
            
            
            columnCount++;
        }
        
        
        
        rowCount++;
    }
    
    
}


